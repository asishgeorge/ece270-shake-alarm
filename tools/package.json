{
  "name": "shake-alarm-tools",
  "private": true,
  "type": "module",
  "description": "Build, simulation and test tools for the ECE 270 Phone Shake Alarm",
  "scripts": {
    "build-flows": "node build-flows.mjs",
    "test": "node --test logic.test.mjs",
    "broker-check": "node --env-file-if-exists=../.env.local broker-check.mjs",
    "e2e": "node --env-file-if-exists=../.env.local e2e.mjs",
    "sim": "node --env-file-if-exists=../.env.local sim.mjs",
    "deploy-demo": "node --env-file-if-exists=../.env.local deploy-demo.mjs"
  },
  "dependencies": {
    "mqtt": "5.16.1"
  },
  "devDependencies": {
    "puppeteer-core": "25.16.0"
  }
}
