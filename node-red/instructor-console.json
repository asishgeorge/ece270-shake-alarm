  {
    "id": "3223204eb460f772",
    "type": "function",
    "z": "d8033978f947c8e9",
    "name": "send class decisions",
    "func": "// One combined message for every phone that lets the console decide. EMQX's free plan\n// allows each client 10 publishes per second, so 30 separate messages at once would be too many.\nif (!flow.get('decisionsChanged')) return null;\nflow.set('decisionsChanged', false);\nconst now = Date.now();\nconst d = {};\nfor (const [name, p] of Object.entries(flow.get('phones') || {})) {\n    if (p.by === 'class' && p.cmd && now - p.last < 5000) d[name] = { cmd: p.cmd, t: p.cmdT };\n}\nreturn { topic: 'ece270/class/cmd/all', payload: JSON.stringify({ t: now, d: d }) };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "info": "",
    "x": 400,
    "y": 360,
    "wires": [
      [
        "fa5f669a00528237"
      ]
    ]
  },
  {
    "id": "531d77a9c5bda539",
    "type": "function",
    "z": "d8033978f947c8e9",
    "name": "earthquake detector",
    "func": "// Class earthquake detector: many phones shaking at the same moment.\nif (!flow.get('quakeOn')) return null;\nconst phones = Object.values(flow.get('phones') || {});\nconst now = Date.now();\nconst active = phones.filter(p => now - p.last < 5000);\n// A phone counts as shaking if it was above the threshold in the last second.\nconst shaking = active.filter(p => now - (p.lastShake || 0) < 1000).length;\nconst need = Math.max(flow.get('quakeMin') ?? 2, Math.ceil(active.length * (flow.get('quakePct') ?? 50) / 100));\n// Students shake their own phones all the time, so random overlaps must not count:\n// enough phones must keep shaking together for a full second.\nif (!active.length || shaking < need) { flow.set('quakeSince', 0); return null; }\nif (!flow.get('quakeSince')) flow.set('quakeSince', now);\nif (now - flow.get('quakeSince') < 1000) return null;\nif (now - (flow.get('lastQuake') || 0) < 15000) return null;   // at most one alert per 15 s\nflow.set('lastQuake', now);\nflow.set('quakeCount', (flow.get('quakeCount') || 0) + 1);\nconst text = 'Earthquake! ' + shaking + ' of ' + active.length + ' phones shook at the same time.';\nreturn [\n    { topic: 'ece270/class/broadcast', payload: JSON.stringify({ level: 'alert', text: text, t: now }) },\n    { payload: 'Earthquake #' + flow.get('quakeCount') + ': ' + shaking + ' of ' + active.length + ' phones' }\n];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "info": "",
    "x": 400,
    "y": 300,
    "wires": [
      [
        "fa5f669a00528237"
      ],
