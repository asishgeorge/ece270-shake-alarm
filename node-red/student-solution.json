  {
    "id": "0b32afa0aabf3ae2",
    "type": "function",
    "z": "98e3f94b01a2d59b",
    "name": "phone connection",
    "func": "const pair = flow.get('pair');\nconst count = flow.get('count') || 0;\nflow.set('count', 0);\nif (!pair) return { payload: 'Not paired yet. Type a pairing name above.' };\nconst last = flow.get('lastReading') || 0;\nconst age = (Date.now() - last) / 1000;\nif (last && age < 3) return { payload: 'Receiving readings (' + count + ' per second)' };\nif (flow.get('phoneState') === 'offline') return { payload: 'Your phone went offline' };\nif (last) return { payload: 'No readings for ' + Math.round(age) + ' s' };\nreturn { payload: 'Waiting for a phone using \"' + pair + '\"' };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "info": "",
    "x": 380,
    "y": 240,
