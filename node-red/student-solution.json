  {
    "id": "02b12d12f095439a",
    "type": "function",
    "z": "98e3f94b01a2d59b",
    "name": "shake level",
    "func": "const { ax, ay, az } = msg.payload;              // m/s², gravity included\nconst g = Math.sqrt(ax*ax + ay*ay + az*az);      // about 9.8 when still\nmsg.payload = +Math.abs(g - 9.81).toFixed(2);    // 0 = still, bigger = shaking\nreturn msg;",
