  {
    "id": "b2df4a93ba32d7de",
    "type": "function",
    "z": "98e3f94b01a2d59b",
    "name": "tell my phone I'm here",
    "func": "// Lets your phone show \"Laptop: Connected\", and tells a phone that just (re)started\n// the laptop's current decision (the filter node only sends changes).\nconst pair = flow.get('pair');\nif (!pair) return null;\nconst beat = { state: 'online', last: flow.get('lastCmd') || null, t: Date.now() };\nreturn { topic: 'ece270/pair/' + pair + '/laptop', payload: JSON.stringify(beat) };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "info": "",
    "x": 380,
    "y": 300,
    "wires": [
      [
        "943a62aa4ec61ec2"
      ]
    ]
  },
  {
    "id": "fea2ee6203570c3d",
    "type": "comment",
    "z": "98e3f94b01a2d59b",
    "name": "YOUR NODES GO HERE: wire from \"phone readings\" ... into \"send to my phone\"",
    "info": "",
    "x": 330,
    "y": 380,
    "wires": []
  },
  {
    "id": "8cda585746d168bf",
    "type": "function",
    "z": "98e3f94b01a2d59b",
    "name": "phone readings (wire from here)",
    "func": "// Every reading from your phone comes out of this node, 5 times per second.\n// msg.payload = { ax, ay, az, gx, gy, gz, t, seq }   (acceleration in m/s², gravity included)\nif (msg.topic.endsWith('/status')) {          // hello / offline messages from the phone\n    flow.set('phoneState', msg.payload && msg.payload.state);\n    return null;\n}\nconst r = msg.payload;\nif (!r || typeof r.ax !== 'number') return null;\nflow.set('lastReading', Date.now());\nflow.set('count', (flow.get('count') || 0) + 1);\nflow.set('phoneState', 'online');\nmsg.t = r.t;   // when the phone took this reading; used to time the round trip\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "info": "",
    "x": 900,
    "y": 120,
    "wires": [
      [
        "02b12d12f095439a"
      ]
    ]
  },
  {
    "id": "5cda6f92fcb53759",
    "type": "function",
    "z": "98e3f94b01a2d59b",
    "name": "send to my phone (wire into here)",
    "func": "// Wire your \"ALERT\" / \"OK\" messages into this node. It addresses them to your phone.\nconst pair = flow.get('pair');\nif (!pair) {\n    node.status({ fill: 'yellow', shape: 'ring', text: 'not paired yet' });\n    return null;\n}\nconst cmd = String(msg.payload).trim().toUpperCase();\nif (cmd !== 'ALERT' && cmd !== 'OK') {\n    node.warn('Send the text ALERT or OK to the phone, not: ' + msg.payload);\n    return null;\n}\nnode.status({ fill: cmd === 'ALERT' ? 'red' : 'green', shape: 'dot', text: cmd });\nflow.set('lastCmd', cmd);\nconst toPhone = {\n    topic: 'ece270/pair/' + pair + '/cmd',\n    payload: JSON.stringify({ cmd: cmd, t: typeof msg.t === 'number' ? msg.t : null })\n};\n// No clock times here: Node.js may have older time-zone rules than the laptop's browser.\nconst n = (flow.get('sentCount') || 0) + 1;\nflow.set('sentCount', n);\nreturn [toPhone, { payload: cmd + '  (command #' + n + ')' }];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "info": "",
    "x": 1160,
    "y": 560,
    "wires": [
      [
        "943a62aa4ec61ec2"
      ],
      [
        "374dbb7c01e33b66"
      ]
    ]
  },
